{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonloom.dev/schemas/narrative-event.schema.json",
  "title": "CanonLoom Narrative Event",
  "type": "object",
  "required": ["event_id", "chapter_id", "subject", "action", "object", "status"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "chapter_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string"},
    "subject": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "time": {"type": "string"},
    "location": {"type": "string"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "changes": {"type": "array", "items": {"type": "string"}},
    "knowledge_delta": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["CANDIDATE", "AUTHOR_CONFIRMED", "CANON"]},
    "status": {"enum": ["PROPOSED", "CONFIRMED", "REJECTED"]}
  },
  "additionalProperties": false
}
